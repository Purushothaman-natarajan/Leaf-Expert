# Leaf-Expert Backend — Environment Variables
# Copy this to .env and fill in your values

APP_NAME="Leaf-Expert API"
APP_VERSION="2.0.0"
DEBUG=false

# CORS: comma-separated frontend origins
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Paths (relative to where uvicorn is launched from)
DATA_DIR=./data
MODEL_DIR=./models
LOG_DIR=./logs

# Training defaults
DEFAULT_BACKBONE=efficientnet_v2_s
DEFAULT_EPOCHS=30
DEFAULT_BATCH_SIZE=32
DEFAULT_LEARNING_RATE=0.001
DEFAULT_PATIENCE=7

# Device: "auto" (auto-detect GPU/MPS/CPU) | "cpu" | "cuda" | "mps"
DEVICE=auto
